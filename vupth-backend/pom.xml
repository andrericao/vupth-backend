	<properties>
		<postgresql.version>42.7.13</postgresql.version>
		<java.version>21</java.version>
		<liquibase.version>4.33.0</liquibase.version>
		<liquibase.hibernate6.version>4.30.0</liquibase.hibernate6.version>
		<awssdk.version>2.29.0</awssdk.version>

		<!-- Cobertura (DEC-7, 02/10): catraca — o minimo sobe a cada medicao e nunca desce. Fracao de
		     0 a 1, sobre o relatorio da suite inteira (mvn verify, o que o CI roda). 03/10: 87,87% linhas, 69,30% branches. -->
		<jacoco.line.minimum>0.87</jacoco.line.minimum>
		<jacoco.branch.minimum>0.69</jacoco.branch.minimum>
		<!-- O JaCoCo preenche argLine com o agente; vazio quando ele nao roda (ex.: -Djacoco.skip). -->
		<argLine></argLine>

		<timestamp>${maven.build.timestamp}</timestamp>
		<maven.build.timestamp.format>dd/MM/yyyy-HH:mm</maven.build.timestamp.format>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
	</properties>

