			<artifactId>mapstruct</artifactId>
			<version>1.6.3</version>
		</dependency>
		<!-- Foto de perfil no Cloudflare R2 (Andre, 25/09): o R2 fala a API do S3, entao o SDK e o da AWS.
		     Sem os clientes HTTP pesados (netty/apache): o url-connection do proprio JDK basta para PUT/DELETE. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>${awssdk.version}</version>
			<exclusions>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>apache-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
			<version>${awssdk.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<encoding>UTF-8</encoding>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<annotationProcessorPaths>

						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.42</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>0.2.0</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>1.6.3</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Bytecode enhancement das entidades (2026-09-06).

			     POR QUE: `BaseUser` tem tres referencias DE VOLTA — owner, professional e client —
			     mapeadas como @OneToOne(mappedBy=..., fetch=LAZY). No lado INVERSO de um one-to-one o
			     LAZY nao existe sem isto: a tabela `base_user` nao tem coluna dizendo se aquela pessoa
			     e profissional, entao o Hibernate PRECISA consultar para saber se o campo e null — e
			     nao da para criar proxy de algo que talvez nao exista. Resultado: ate 3 SELECTs a mais
			     por BaseUser carregado, em TODO lugar (login, perfil, fila, cada broadcast do
			     WebSocket, cada linha de listagem que traz gente). A anotacao dizia LAZY e cobrava
			     EAGER; e por isso que ninguem via.

			     Este plugin reescreve as entidades no build para interceptar o acesso ao campo — e ai
			     o LAZY passa a ser verdade.

			     ⚠️ O QUE MUDA DE RISCO: campo que antes vinha preenchido "de graca" agora so carrega
			     no acesso. Ler um desses campos FORA da transacao passa a estourar
			     LazyInitializationException onde antes devolvia o valor. Nao e o plugin quebrando
			     nada — e ele expondo dependencia que ja existia (com OSIV desligado em staging/prod,
			     esse tipo de leitura ja era ilegal na pratica). Por isso a suite inteira e o criterio
			     de aceite desta mudanca, nao os testes da frente que a motivou.

			     enableAssociationManagement fica DESLIGADO de proposito: ele mexe em como os dois
			     lados de uma associacao se mantem em sincronia e muda semantica de gravacao, o que
			     nao tem nada a ver com o problema que estamos resolvendo. -->
			<plugin>
				<groupId>org.hibernate.orm.tooling</groupId>
				<artifactId>hibernate-enhance-maven-plugin</artifactId>
				<version>${hibernate.version}</version>
				<executions>
					<execution>
						<id>enhance</id>
						<goals>
							<goal>enhance</goal>
						</goals>
						<configuration>
							<enableLazyInitialization>true</enableLazyInitialization>
							<enableDirtyTracking>true</enableDirtyTracking>
							<enableAssociationManagement>false</enableAssociationManagement>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- reuseForks=true: uma unica JVM roda todas as classes, deixando o CACHE DE
			     CONTEXTO do Spring reusar o mesmo ApplicationContext entre elas. As ~53 classes
			     de integracao compartilham a mesma assinatura de contexto (@SpringBootTest
			     RANDOM_PORT + @AutoConfigureMockMvc + @ActiveProfiles("test")), entao o contexto
			     (e o drop-first do Liquibase, que re-roda as 71 migrations) sobe ~2-3x em vez de
			     53x — corta a suite de ~20min para poucos minutos.
			     PRE-REQUISITO ja garantido: (a) o timer de promocao de intencao nao vaza entre
			     classes (auto-arm=false nos testes + thread daemon, ver IntentionPromotionScheduler);
			     (b) como o DB NAO e mais dropado entre classes que compartilham contexto, cada
			     classe precisa limpar seus proprios dados (deleteAll no setup/teardown) — padrao ja
			     seguido pela maioria. Uma classe que assuma "tabela vazia" sem limpar deve ganhar o
			     deleteAll. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<forkCount>1</forkCount>
					<reuseForks>true</reuseForks>
					<!-- Mockito 5 (inline mock maker) + ByteBuddy retransformacao + CDS ("sharing")
					     causa flakiness "Could not modify all classes / NoClassDefFoundError" no suite
					     completo (nao reproduz em isolamento). -Xshare:off desliga o CDS no fork.
					     -XX:+EnableDynamicAgentLoading silencia o warning de self-attach do agente. -->
					<argLine>@{argLine} -Xshare:off -XX:+EnableDynamicAgentLoading</argLine>
				</configuration>
			</plugin>
			<!-- Cobertura (DEC-7). Declarado DEPOIS do surefire: no mesmo phase, o relatorio roda depois
			     dos testes. mvn test gera target/site/jacoco (index.html e jacoco.csv, o numero da caixa
			     de Cobertura no vupth-docs); o check com o minimo fica no verify, que o CI roda — assim o
			     mvn test em fatias (-Dtest=...) mede sem reprovar por cobertura parcial. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.line.minimum}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.branch.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.liquibase</groupId>
				<artifactId>liquibase-maven-plugin</artifactId>
				<version>${liquibase.version}</version>

				<configuration>
					<propertyFile>src/main/resources/liquibase/liquibase.properties</propertyFile>
				</configuration>

				<dependencies>

					<!--
					<dependency>
						<groupId>org.liquibase</groupId>
						<artifactId>liquibase-core</artifactId>
						<version>${liquibase.version}</version>
					</dependency>
					-->

					<dependency>
						<groupId>org.liquibase.ext</groupId>
						<artifactId>liquibase-hibernate6</artifactId>
						<version>${liquibase.hibernate6.version}</version>
					</dependency>

					<!-- Hibernate Core compatível com liquibase-hibernate6 -->
					<dependency>
						<groupId>org.hibernate.orm</groupId>
						<artifactId>hibernate-core</artifactId>
						<version>${hibernate.version}</version>
					</dependency>

					<dependency>
						<groupId>org.postgresql</groupId>
						<artifactId>postgresql</artifactId>
						<version>${postgresql.version}</version>
					</dependency>

					<!--
					<dependency>
						<groupId>jakarta.validation</groupId>
						<artifactId>jakarta.validation-api</artifactId>
						<version>3.0.2</version>
					</dependency>

					<dependency>
						<groupId>org.hibernate.validator</groupId>
						<artifactId>hibernate-validator</artifactId>
						<version>${hibernate-validator.version}</version>
					</dependency>

					<dependency>
						<groupId>org.springframework.data</groupId>
						<artifactId>spring-data-jpa</artifactId>
						<version>3.5.4</version>
					</dependency>
					-->

				</dependencies>
			</plugin>

		</plugins>
	</build>

</project>

