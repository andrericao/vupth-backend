{
 "info": {
  "name": "VUPTH - fumaca (essencial)",
  "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
  "description": "Teste de fumaca do Backend (DEC-157): cadastro e login de dono, profissional e cliente; loja; servico; profissional chega; cliente entra na fila; pagamento manual (Ja paguei, inicia, finaliza, Recebi); limpeza das contas fumaca-*. Sem dinheiro real, sem gateway. Nao prova: dinheiro real no Asaas, push real, e-mail real."
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{owner_token}}",
    "type": "string"
   }
  ]
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "// DEC-157 (teste de fumaca): contas descartaveis com o padrao fumaca-<timestamp>-... (a limpeza so apaga o que for deste padrao).",
     "// Nunca usa dinheiro real: o pagamento e o Pix manual (claim/confirm) do proprio app, sem gateway.",
     "const ts = pm.collectionVariables.get('fumaca_ts') || String(Date.now());",
     "pm.collectionVariables.set('fumaca_ts', ts);",
     "for (const [k, who] of [['owner_email','owner'],['prof_email','prof'],['client_email','client']]) {",
     "  if (!pm.collectionVariables.get(k)) pm.collectionVariables.set(k, 'fumaca-' + ts + '-' + who + '@vupth.test');",
     "  if (!pm.collectionVariables.get(who + '_password')) pm.collectionVariables.set(who + '_password', 'Senha@123');",
     "}",
     "// CI (decisao de 05/10): com ci_secret (--env-var no Actions), todo request leva o header X-Vupth-CI// e passa por fora do rate limit de auth do staging/prod. Local: sem ci_secret, nada muda.const ciSecret = pm.variables.get('ci_secret');if (ciSecret) { pm.request.headers.upsert({ key: 'X-Vupth-CI', value: ciSecret }); }"
    ]
   }
  }
 ],
