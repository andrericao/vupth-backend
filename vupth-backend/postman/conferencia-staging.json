      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const ts = Date.now();",
         "pm.collectionVariables.set(\"cf_ts\", ts);",
         "pm.collectionVariables.set(\"cf_owner_email\", \"conf_dono_\" + ts + \"@vupth.test\");",
         "pm.collectionVariables.set(\"cf_client_email\", \"conf_cliente_\" + ts + \"@vupth.test\");",
         "pm.collectionVariables.set(\"cf_pass\", \"Senha123!\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Status 201\", () => pm.expect(pm.response.code, pm.response.text()).to.equal(201));"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{base_url}}/auth/register",
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\"email\":\"{{cf_owner_email}}\",\"password\":\"{{cf_pass}}\"}",
       "options": {
        "raw": {
         "language": "json"
        }
