{
 "info": {
  "name": "Vupth backend — conferencia no staging (conferencia-por-script)",
  "description": "O que o Andre conferia a mao, conferido no staging pela API. Cria as contas @vupth.test que usa e apaga no fim. Rodar: bash scripts/conferir-staging.sh",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "const ciSecret = pm.variables.get('ci_secret');",
     "if (ciSecret) { pm.request.headers.upsert({ key: 'X-Vupth-CI', value: ciSecret }); }"
    ]
   }
  }
 ],
