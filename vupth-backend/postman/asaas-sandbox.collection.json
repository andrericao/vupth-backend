   "name": "06 criar a cobranca Pix no sandbox (R$ 32,90): POST .../sandbox/charges",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
       "const b = pm.response.json();",
       "pm.test(\"cobranca criada e pendente\", () => { pm.expect(b.payment_id).to.be.a(\"string\"); pm.expect(b.status).to.eql(\"PENDING\"); pm.expect(b.billing_type).to.eql(\"PIX\"); });",
       "pm.collectionVariables.set(\"payment_id\", b.payment_id);",
       "console.log(\"PAGUE NO SANDBOX: abra a cobranca \" + b.payment_id + \" no painel do Asaas sandbox e simule o pagamento; depois rode de novo so a verificacao (PAYMENT_ID=\" + b.payment_id + \"). Link: \" + b.invoice_url);"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer {{ADMIN_TOKEN}}",
      "type": "text"
     }
    ],
    "url": "{{base_url}}/admin/finance/asaas/sandbox/charges",
    "auth": {
     "type": "noauth"
    },
    "body": {
     "mode": "raw",
     "raw": "{\"amount\":32.90,\"billing_type\":\"PIX\"}"
    }
