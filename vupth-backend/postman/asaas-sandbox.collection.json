  {
   "name": "07 relatorio do sandbox: sem bonus em not_measured; com o webhook, preco de tabela, cupom, bonificacao e diferenca",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "pm.test(\"DEC-119: bonus deixou de ser nao medido\", () => pm.expect(b.not_measured).to.be.an(\"array\").that.is.empty);",
       "const id = pm.variables.get(\"PAYMENT_ID\") || pm.collectionVariables.get(\"payment_id\");",
       "const line = (b.payments || []).find(p => p.payment_id === id);",
       "if (line && [\"RECEIVED\",\"CONFIRMED\",\"RECEIVED_IN_CASH\"].includes(line.status)) {",
       "  pm.test(\"webhook chegou (\" + line.status + \"): valor pago e taxa real do Asaas\", () => { pm.expect(line.client_paid).to.be.a(\"number\"); pm.expect(line.asaas_net).to.be.a(\"number\"); pm.expect(line.asaas_fee_real).to.be.a(\"number\"); });",
       "  if (line.attendance_id) pm.test(\"cobranca de atendimento: preco de tabela, cupom, bonificacao e diferenca em centavos\", () => { pm.expect(line.list_price).to.be.a(\"number\"); pm.expect(line.coupon_discount).to.be.a(\"number\"); pm.expect(line.bonus).to.be.a(\"number\"); pm.expect(line.difference_cents).to.be.a(\"number\"); });",
       "} else { console.log(\"Sem aviso de pagamento ainda para \" + id + \": simule o pagamento no painel do Asaas sandbox e repita este passo.\"); }"
      ]
     }
    },
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.request.url.query.add({key:\"from\", value:new Date(Date.now() - 24*3600e3).toISOString()});"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
