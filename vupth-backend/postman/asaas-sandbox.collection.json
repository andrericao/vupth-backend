{
 "info": {
  "name": "VUPTH — Asaas sandbox: passo a passo do admin (newman-asaas)",
  "description": "Executa DE VERDADE, contra o sandbox do Asaas no Render, o passo a passo do admin (orquestrador, passo O). Separada do postman/collection.json (depende de rede, da chave e de um token de ADMIN). O token vem pela variavel ADMIN_TOKEN (login pelo Authorize do Swagger) e NUNCA fica no repositorio. Rode com asaas-sandbox.sh.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "00 token do ADMIN fornecido (variavel ADMIN_TOKEN)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"ADMIN_TOKEN veio pela variavel (o login e do Authorize do Swagger; o token nunca vai ao repositorio)\", () => pm.expect(pm.variables.get(\"ADMIN_TOKEN\"), \"passe --env-var ADMIN_TOKEN=... (ou use asaas-sandbox.sh)\").to.be.a(\"string\").and.not.empty);",
       "pm.test(\"staging acordado (readiness UP)\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
      ]
     }
    }
   ],
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "{{base_url}}/actuator/health/readiness",
    "auth": {
     "type": "noauth"
    }
   },
   "response": []
  },
